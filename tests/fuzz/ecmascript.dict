# A dictionary for the fuzz harnesses (libFuzzer -dict): the words and
# punctuators of the lexical grammar, the escapes, and the forms that need the
# parser to decide. The harnesses read a header byte first and then text, so the
# entries are text.

# Keywords and contextual words
kw1="break"
kw2="case"
kw3="catch"
kw4="class"
kw5="const"
kw6="continue"
kw7="debugger"
kw8="default"
kw9="delete"
kw10="do"
kw11="else"
kw12="enum"
kw13="export"
kw14="extends"
kw15="finally"
kw16="for"
kw17="function"
kw18="if"
kw19="import"
kw20="in"
kw21="instanceof"
kw22="new"
kw23="return"
kw24="super"
kw25="switch"
kw26="this"
kw27="throw"
kw28="try"
kw29="typeof"
kw30="var"
kw31="void"
kw32="while"
kw33="with"
kw34="yield"
kw35="let"
kw36="static"
kw37="async"
kw38="await"
kw39="of"
kw40="get"
kw41="set"
kw42="target"
kw43="meta"
kw44="from"
kw45="as"
kw46="accessor"
kw47="implements"
kw48="interface"
kw49="package"
kw50="private"
kw51="protected"
kw52="public"
kw53="arguments"
kw54="eval"
kw55="null"
kw56="true"
kw57="false"
kw58="constructor"
kw59="prototype"
kw60="__proto__"
kw61="use strict"
kw62="'use strict'"
kw63="new.target"
kw64="import.meta"
kw65="for await"
kw66="async function"
kw67="async function*"
kw68="async ("
kw69="export default"
kw70="export *"
kw71="export {"
kw72="import {"
kw73="import * as"
kw74="with {"
kw75="#"
kw76="#p"
kw77="#p in"

# Punctuators
p1="{"
p2="}"
p3="("
p4=")"
p5="["
p6="]"
p7="."
p8="..."
p9=";"
p10=","
p11="<"
p12=">"
p13="<="
p14=">="
p15="=="
p16="!="
p17="==="
p18="!=="
p19="+"
p20="-"
p21="*"
p22="/"
p23="%"
p24="**"
p25="++"
p26="--"
p27="<<"
p28=">>"
p29=">>>"
p30="&"
p31="|"
p32="^"
p33="!"
p34="~"
p35="&&"
p36="||"
p37="??"
p38="?"
p39="?."
p40=":"
p41="="
p42="+="
p43="-="
p44="*="
p45="/="
p46="%="
p47="**="
p48="<<="
p49=">>="
p50=">>>="
p51="&="
p52="|="
p53="^="
p54="&&="
p55="||="
p56="??="
p57="=>"
p58="<!--"
p59="-->"
p60="/*"
p61="*/"
p62="//"
p63="#!"
p64="\x0a"
p65="\x0d\x0a"

# Literals and escapes
n1="0"
n2="0x"
n3="0b"
n4="0o"
n5="1_0"
n6="1e+"
n7=".5"
n8="5."
n9="0n"
n10="07"
n11="08"
n12="09.5"
s1="\\x41"
s2="\\u0041"
s3="\\u{41}"
s4="\\u{110000}"
s5="\\0"
s6="\\07"
s7="\\8"
s8="\\u{"
s9="\\"
s10="\\u"
s11="'"
s12="\""
s13="`"
s14="${"
s15="\\${"
s16="\xe2\x80\xa8"
s17="\xe2\x80\xa9"
s18="\xc2\xa0"
s19="\xef\xbb\xbf"
s20="\xed\xa0\x80"
s21="\xf0\x9f\x98\x80"
s22="\\ud800"
s23="\\u{d800}"
r1="/[/]/"
r2="/(?<n>a)\\k<n>/u"
r3="/[\\p{L}--[a-z]]/v"
r4="/a{2,1}/"
r5="/(?i:a)/"
r6="/\\p{Script=Greek}/u"
r7="/(?:a|b)+?/dgimsuy"

# Forms that need the parser to decide
c1="(a, b) => "
c2="({a = 1}) => "
c3="([a, b] = c) => "
c4="async (a) => "
c5="({a = 1} = b)"
c6="[a, ...b] = c"
c7="for (let of x)"
c8="for (async of x)"
c9="for (let in x)"
c10="class A { static { } }"
c11="class A { #a; static #b() {} get #c() {} }"
c12="a?.b"
c13="a?.[b]"
c14="a?.(b)"
c15="a\x0a++b"
c16="a\x0a(b)"
c17="x => {}"
c18="function* g() { yield* y }"
c19="label: for (;;) break label"
c20="if (a) function f() {}"
c21="try {} catch {}"
c22="new a.b()"
c23="super.x"
c24="super()"
c25="export var a"
c26="import('m')"
c27="await import('m')"
c28="using a = b"
